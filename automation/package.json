{
  "name": "job-application-browser-executor",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic Playwright execution adapter for the autonomous job-application workspace",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "dry-run": "tsx src/runner.ts --dry-run",
    "execute": "tsx src/runner.ts",
    "workspace": "tsx src/workspace-cli.ts",
    "search": "tsx src/workspace-cli.ts search",
    "apply-native": "tsx src/workspace-cli.ts apply native",
    "show-external": "tsx src/workspace-cli.ts show external"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
