# Private candidate data and uploaded resumes.
/candidate/*
!/candidate/README.md
!/candidate/.gitkeep
!/candidate/inbox/
/candidate/inbox/*
!/candidate/inbox/README.md
/candidate/resumes/
/candidate/onboarding.json
/candidate/onboarding-questions.md
/candidate/parsed-resume.txt
/resumes/

# Private runtime state, history, browser payloads, and generated artifacts.
/application-history.md
/state/*
!/state/README.md
!/state/.gitkeep
!/state/run-state.example.md
/tmp/*
!/tmp/.gitkeep

# Local secrets and ad-hoc application payloads.
.env
.env.*
!.env.example
**/*.payload.json
**/*.local.json
**/*.local.*

# Local browser and generated automation artifacts.
/automation/.profile/
/automation/dist/
/automation/test-results/
/automation/*.local.json

# OS/editor files.
.DS_Store
